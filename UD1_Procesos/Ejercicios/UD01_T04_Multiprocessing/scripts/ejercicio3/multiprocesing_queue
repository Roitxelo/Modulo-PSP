import multiprocessing
import random

def enviar(cola):
    for i in range(5):
        numero = random.randint(1, 10)
        cola.put(numero)
        print("Enviado:", numero)

    cola.put(None)

def recibir(cola):
    suma = 0

    while True:
        numero = cola.get()

        if numero is None:
            break

        suma += numero

    print("Suma total:", suma)

if __name__ == "__main__":
    cola = multiprocessing.Queue()

    p1 = multiprocessing.Process(target=enviar, args=(cola,))
    p2 = multiprocessing.Process(target=recibir, args=(cola,))

    p1.start()
    p2.start()

    p1.join()
    p2.join()